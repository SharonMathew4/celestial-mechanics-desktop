<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ Deep Backgrounds ══ -->
    <Color x:Key="BackgroundPrimaryColor">#FF0A0E17</Color>
    <Color x:Key="BackgroundSecondaryColor">#FF121829</Color>
    <Color x:Key="BackgroundTertiaryColor">#FF1A2236</Color>

    <!-- ══ Surfaces ══ -->
    <Color x:Key="SurfaceColor">#FF1E2740</Color>
    <Color x:Key="SurfaceHoverColor">#FF243050</Color>

    <!-- ══ Borders ══ -->
    <Color x:Key="BorderPrimaryColor">#FF2A3454</Color>
    <Color x:Key="BorderSecondaryColor">#FF1C2540</Color>

    <!-- ══ Accents ══ -->
    <Color x:Key="AccentCyanColor">#FF4FC3F7</Color>
    <Color x:Key="AccentPurpleColor">#FF7C4DFF</Color>
    <Color x:Key="AccentWarmColor">#FFFFB74D</Color>
    <Color x:Key="GlowCyanColor">#FF00E5FF</Color>
    <Color x:Key="GlowPurpleColor">#FFB388FF</Color>

    <!-- ══ Text ══ -->
    <Color x:Key="TextPrimaryColor">#FFE8EAF0</Color>
    <Color x:Key="TextSecondaryColor">#FF8892B0</Color>
    <Color x:Key="TextDisabledColor">#FF4A5272</Color>

    <!-- ══ Status ══ -->
    <Color x:Key="StatusGreenColor">#FF66BB6A</Color>
    <Color x:Key="StatusYellowColor">#FFFFA726</Color>
    <Color x:Key="StatusRedColor">#FFEF5350</Color>

    <!-- ══ Brushes ══ -->
    <SolidColorBrush x:Key="BackgroundPrimary" Color="{StaticResource BackgroundPrimaryColor}"/>
    <SolidColorBrush x:Key="BackgroundSecondary" Color="{StaticResource BackgroundSecondaryColor}"/>
    <SolidColorBrush x:Key="BackgroundTertiary" Color="{StaticResource BackgroundTertiaryColor}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="BorderPrimary" Color="{StaticResource BorderPrimaryColor}"/>
    <SolidColorBrush x:Key="BorderSecondary" Color="{StaticResource BorderSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentCyan" Color="{StaticResource AccentCyanColor}"/>
    <SolidColorBrush x:Key="AccentPurple" Color="{StaticResource AccentPurpleColor}"/>
    <SolidColorBrush x:Key="AccentWarm" Color="{StaticResource AccentWarmColor}"/>
    <SolidColorBrush x:Key="GlowCyan" Color="{StaticResource GlowCyanColor}"/>
    <SolidColorBrush x:Key="GlowPurple" Color="{StaticResource GlowPurpleColor}"/>
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="StatusGreen" Color="{StaticResource StatusGreenColor}"/>
    <SolidColorBrush x:Key="StatusYellow" Color="{StaticResource StatusYellowColor}"/>
    <SolidColorBrush x:Key="StatusRed" Color="{StaticResource StatusRedColor}"/>

</ResourceDictionary>
