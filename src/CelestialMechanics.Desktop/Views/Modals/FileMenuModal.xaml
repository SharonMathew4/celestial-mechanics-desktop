<UserControl x:Class="CelestialMechanics.Desktop.Views.Modals.FileMenuModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- File Menu: Save, Save As, Import, Share, Preferences -->
    <Border HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="400" Height="350"
            Background="{StaticResource ModalPanel}"
            CornerRadius="16"
            BorderBrush="{StaticResource BorderPrimary}"
            BorderThickness="1"
            Padding="20,0">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="FILE"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource CyanAccent}"
                       HorizontalAlignment="Center"
                       Margin="0,25,0,20"/>

            <!-- Menu Buttons -->
            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                <!-- Save -->
                <Button Style="{StaticResource ModalNavButtonStyle}"
                        Command="{Binding SaveCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8">
                    <DockPanel Width="320">
                        <TextBlock Text="Save" VerticalAlignment="Center"/>
                        <TextBlock Text="Ctrl+S"
                                   Style="{StaticResource ShortcutHintStyle}"
                                   DockPanel.Dock="Right"/>
                    </DockPanel>
                </Button>

                <!-- Save As -->
                <Button Style="{StaticResource ModalNavButtonStyle}"
                        Command="{Binding SaveAsCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8">
                    <DockPanel Width="320">
                        <TextBlock Text="Save As" VerticalAlignment="Center"/>
                        <TextBlock Text="Ctrl+Shift+S"
                                   Style="{StaticResource ShortcutHintStyle}"
                                   DockPanel.Dock="Right"/>
                    </DockPanel>
                </Button>

                <!-- Import -->
                <Button Content="Import"
                        Style="{StaticResource ModalNavButtonStyle}"
                        Command="{Binding ImportCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"/>

                <!-- Share (disabled, future) -->
                <Button Content="Share"
                        Style="{StaticResource ModalNavButtonStyle}"
                        Command="{Binding ShareCommand}"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False"
                        Margin="0,0,0,8"/>

                <!-- Preferences -->
                <Button Content="Preferences"
                        Style="{StaticResource ModalNavButtonStyle}"
                        Command="{Binding PreferencesCommand}"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Back -->
            <Button Grid.Row="2"
                    Content="&#x2190; Back"
                    Style="{StaticResource ModalBackButtonStyle}"
                    Command="{Binding BackCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,15"/>
        </Grid>
    </Border>
</UserControl>
