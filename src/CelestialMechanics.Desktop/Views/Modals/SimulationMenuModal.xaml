<UserControl x:Class="CelestialMechanics.Desktop.Views.Modals.SimulationMenuModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Simulation Menu: New Project, File, Projects, Settings -->
    <Border HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="400" Height="350"
            Background="{StaticResource ModalPanel}"
            CornerRadius="16"
            BorderBrush="{StaticResource BorderPrimary}"
            BorderThickness="1"
            Padding="20,0">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="SIMULATION"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource CyanAccent}"
                       HorizontalAlignment="Center"
                       Margin="0,25,0,20"/>

            <!-- Menu Buttons -->
            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                <Button Content="New Project"
                        Style="{StaticResource ModalNavButtonAccentStyle}"
                        Command="{Binding NewProjectCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"/>

                <Button Content="File"
                        Style="{StaticResource ModalNavButtonStyle}"
                        Command="{Binding FileCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"/>

                <Button Content="Projects"
                        Style="{StaticResource ModalNavButtonStyle}"
                        Command="{Binding ProjectsCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"/>

                <Button Content="Settings"
                        Style="{StaticResource ModalNavButtonStyle}"
                        Command="{Binding SettingsCommand}"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False"/>
            </StackPanel>

            <!-- Back -->
            <Button Grid.Row="2"
                    Content="&#x2190; Back"
                    Style="{StaticResource ModalBackButtonStyle}"
                    Command="{Binding BackCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,15"/>
        </Grid>
    </Border>
</UserControl>
