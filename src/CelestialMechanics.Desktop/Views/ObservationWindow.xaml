<Window x:Class="CelestialMechanics.Desktop.Views.ObservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Celestial Mechanics — Observation Mode"
        WindowStyle="None"
        WindowState="Maximized"
        AllowsTransparency="True"
        Background="#FF050810"
        ResizeMode="CanResize">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>   <!-- Title bar -->
            <RowDefinition Height="28"/>   <!-- Menu bar -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="32"/>   <!-- Bottom toolbar -->
            <RowDefinition Height="24"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════
             ROW 0: CUSTOM TITLE BAR — 32px
             ═══════════════════════════════════════════════════ -->
        <DockPanel Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                   MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource BorderBaseBrush}"/>

            <!-- Left: App icon + title -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <!-- Telescope icon -->
                <Canvas Width="14" Height="14" Margin="0,0,6,0">
                    <Path Data="M 3 12 L 7 3 L 9 4 L 5 11 Z"
                          Fill="{StaticResource AccentCyanBrush}" Opacity="0.8"/>
                    <Ellipse Width="4" Height="4" Canvas.Left="9" Canvas.Top="2"
                             Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="0.8" Fill="Transparent"/>
                </Canvas>
                <TextBlock Text="OBSERVATION MODE" FontSize="11" FontWeight="Normal"
                           Foreground="{StaticResource AccentCyanBrush}"
                           VerticalAlignment="Center" Opacity="0.9"/>
            </StackPanel>

            <!-- Right: Window controls -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Center">
                <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        ToolTip="Minimize" Style="{StaticResource ControlBarButtonStyle}"
                        Click="MinimizeButton_Click"/>
                <Button Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        ToolTip="Maximize/Restore" Style="{StaticResource ControlBarButtonStyle}"
                        Click="MaximizeButton_Click"/>
                <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        ToolTip="Close" Style="{StaticResource ControlBarButtonStyle}"
                        Click="CloseButton_Click"/>
            </StackPanel>

            <!-- Spacer -->
            <Border/>
        </DockPanel>

        <!-- ═══════════════════════════════════════════════════
             ROW 1: MENU BAR — 28px
             ═══════════════════════════════════════════════════ -->
        <DockPanel Grid.Row="1" Background="{StaticResource BgSecondaryBrush}">
            <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource BorderBaseBrush}"/>

            <Menu Background="Transparent" VerticalAlignment="Center" Margin="8,0,0,0">
                <Menu.Resources>
                    <Style TargetType="MenuItem">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                </Menu.Resources>
                <MenuItem Header="_File">
                    <MenuItem Header="_Return to Mode Select" Click="ReturnToModeSelect_Click"/>
                    <Separator/>
                    <MenuItem Header="E_xit" Click="CloseButton_Click"/>
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="_Search Panel" IsCheckable="True" x:Name="MenuSearchPanel"/>
                    <MenuItem Header="_Object Inspector" IsCheckable="True" x:Name="MenuInspector"/>
                    <MenuItem Header="_AI Panel" IsCheckable="True" x:Name="MenuAIPanel"/>
                    <Separator/>
                    <MenuItem Header="Show _Coordinate Axes" IsCheckable="True" IsChecked="True" x:Name="MenuAxes"/>
                    <MenuItem Header="Show _Grid" IsCheckable="True" x:Name="MenuGrid"/>
                </MenuItem>
                <MenuItem Header="_Tools">
                    <MenuItem Header="_Navigate To..." IsEnabled="False"/>
                    <MenuItem Header="_Measure Distance" IsEnabled="False"/>
                    <Separator/>
                    <MenuItem Header="_Catalog Browser" IsEnabled="False"/>
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="_Keyboard Shortcuts" IsEnabled="False"/>
                    <MenuItem Header="_About Observation Mode" Click="AboutObservation_Click"/>
                </MenuItem>
            </Menu>

            <Border/>
        </DockPanel>

        <!-- ═══════════════════════════════════════════════════
             ROW 2: MAIN CONTENT AREA — Search | Viewport | Inspector
             ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>   <!-- Search panel -->
                <ColumnDefinition Width="*"/>      <!-- Viewport -->
                <ColumnDefinition Width="Auto"/>   <!-- Inspector panel -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: Search Panel Placeholder (collapsed by default) -->
            <Border Grid.Column="0" Width="280" Background="{StaticResource BgSecondaryBrush}"
                    Visibility="Collapsed" x:Name="SearchPanel">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="1" Background="{StaticResource BorderBaseBrush}"/>
                    <DockPanel Margin="12,12,12,12">
                        <TextBlock DockPanel.Dock="Top" Text="SEARCH" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="4"
                                Height="30" DockPanel.Dock="Top">
                            <TextBlock Text="Search catalogs..." FontSize="12"
                                       Foreground="{StaticResource TextDisabledBrush}"
                                       VerticalAlignment="Center" Margin="8,0"/>
                        </Border>
                        <TextBlock Text="No catalogs loaded" FontSize="11"
                                   Foreground="{StaticResource TextDisabledBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </DockPanel>
                </DockPanel>
            </Border>

            <!-- CENTER: Viewport -->
            <Border Grid.Column="1" Background="#FF000000" x:Name="ViewportBorder"
                    ClipToBounds="True">
                <Grid>
                    <!-- The black viewport — future OpenGL host surface -->
                    <Border x:Name="GlViewport" Background="#FF000000"
                            MouseMove="Viewport_MouseMove"
                            MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                            MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                            MouseRightButtonDown="Viewport_MouseRightButtonDown"
                            MouseRightButtonUp="Viewport_MouseRightButtonUp"
                            MouseWheel="Viewport_MouseWheel">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Reset Camera" Click="ResetCamera_Click"/>
                                <Separator/>
                                <MenuItem Header="Toggle Axes" Click="ToggleAxes_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                    </Border>

                    <!-- Viewport overlay: Coordinate axes indicator (top-left) -->
                    <Canvas x:Name="AxesOverlay" Width="80" Height="80"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="12,0,0,12" IsHitTestVisible="False">
                        <!-- X axis (Red) -->
                        <Line X1="40" Y1="40" X2="70" Y2="40"
                              Stroke="#FFE04040" StrokeThickness="1.5"
                              StrokeEndLineCap="Triangle"/>
                        <TextBlock Text="X" Canvas.Left="72" Canvas.Top="34"
                                   FontSize="10" Foreground="#FFE04040"/>
                        <!-- Y axis (Green) -->
                        <Line X1="40" Y1="40" X2="40" Y2="10"
                              Stroke="#FF40E040" StrokeThickness="1.5"
                              StrokeEndLineCap="Triangle"/>
                        <TextBlock Text="Y" Canvas.Left="34" Canvas.Top="0"
                                   FontSize="10" Foreground="#FF40E040"/>
                        <!-- Z axis (Blue) -->
                        <Line X1="40" Y1="40" X2="20" Y2="58"
                              Stroke="#FF4080E0" StrokeThickness="1.5"
                              StrokeEndLineCap="Triangle"/>
                        <TextBlock Text="Z" Canvas.Left="10" Canvas.Top="56"
                                   FontSize="10" Foreground="#FF4080E0"/>
                    </Canvas>

                    <!-- Viewport overlay: Camera info (top-right) -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,8,12,0" IsHitTestVisible="False">
                        <TextBlock x:Name="CameraInfoText" Text="Camera: Free"
                                   FontSize="10" Foreground="{StaticResource TextDisabledBrush}"
                                   HorizontalAlignment="Right"/>
                        <TextBlock x:Name="FpsText" Text="FPS: --"
                                   FontSize="10" Foreground="{StaticResource TextDisabledBrush}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>

                    <!-- Center crosshair -->
                    <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="20" Height="20" IsHitTestVisible="False" Opacity="0.3">
                        <Line X1="10" Y1="0" X2="10" Y2="8" Stroke="#AAFFFFFF" StrokeThickness="1"/>
                        <Line X1="10" Y1="12" X2="10" Y2="20" Stroke="#AAFFFFFF" StrokeThickness="1"/>
                        <Line X1="0" Y1="10" X2="8" Y2="10" Stroke="#AAFFFFFF" StrokeThickness="1"/>
                        <Line X1="12" Y1="10" X2="20" Y2="10" Stroke="#AAFFFFFF" StrokeThickness="1"/>
                    </Canvas>
                </Grid>
            </Border>

            <!-- RIGHT: Object Inspector Placeholder (collapsed by default) -->
            <Border Grid.Column="2" Width="300" Background="{StaticResource BgSecondaryBrush}"
                    Visibility="Collapsed" x:Name="InspectorPanel">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource BorderBaseBrush}"/>
                    <DockPanel Margin="12,12,12,12">
                        <TextBlock DockPanel.Dock="Top" Text="OBJECT INSPECTOR" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="No object selected" FontSize="11"
                                   Foreground="{StaticResource TextDisabledBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════
             ROW 3: BOTTOM TOOLBAR — 32px
             ═══════════════════════════════════════════════════ -->
        <DockPanel Grid.Row="3" Background="{StaticResource BgSecondaryBrush}">
            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBaseBrush}"/>

            <!-- Left: Layer toggles placeholder -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                <TextBlock Text="LAYERS:" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource TextDisabledBrush}" Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Stars" FontSize="10"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"
                           VerticalAlignment="Center" Opacity="0.5"/>
                <TextBlock Text="Constellations" FontSize="10"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"
                           VerticalAlignment="Center" Opacity="0.5"/>
                <TextBlock Text="Grid" FontSize="10"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"
                           VerticalAlignment="Center" Opacity="0.5"/>
                <TextBlock Text="Orbits" FontSize="10"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Opacity="0.5"/>
            </StackPanel>

            <!-- Right: Time controls placeholder -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="J2000.0" FontSize="10" FontFamily="Consolas"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="▶ 1.0×" FontSize="10"
                           Foreground="{StaticResource AccentCyanBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Border/>
        </DockPanel>

        <!-- ═══════════════════════════════════════════════════
             ROW 4: STATUS BAR — 24px
             ═══════════════════════════════════════════════════ -->
        <DockPanel Grid.Row="4" Background="{StaticResource BgPrimaryBrush}">
            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBaseBrush}"/>

            <!-- Left: Mode indicator -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentCyanBrush}" Margin="0,0,6,0"/>
                <TextBlock Text="Observation Mode" FontSize="10"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- Right: Coordinates placeholder -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusCoords" Text="RA: --h --m | Dec: --° --'"
                           FontSize="10" FontFamily="Consolas"
                           Foreground="{StaticResource TextDisabledBrush}" Margin="0,0,16,0"/>
                <TextBlock x:Name="StatusZoom" Text="Zoom: 1.0×"
                           FontSize="10" FontFamily="Consolas"
                           Foreground="{StaticResource TextDisabledBrush}"/>
            </StackPanel>

            <!-- Center: Status message -->
            <TextBlock x:Name="StatusMessage" Text="Ready — No catalogs loaded"
                       FontSize="10" Foreground="{StaticResource TextDisabledBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- ═══ AI PANEL PLACEHOLDER (collapsed overlay, right side) ═══ -->
        <Border Grid.Row="2" Grid.RowSpan="2" HorizontalAlignment="Right" Width="320"
                Background="{StaticResource BgSecondaryBrush}" Visibility="Collapsed"
                x:Name="AIPanel">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource BorderBaseBrush}"/>
                <DockPanel Margin="12,12,12,12">
                    <TextBlock DockPanel.Dock="Top" Text="AI ASSISTANT" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="AI features not yet available" FontSize="11"
                               Foreground="{StaticResource TextDisabledBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </DockPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
