<Window x:Class="CelestialMechanics.Desktop.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Width="900"
        Height="500"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">
    <Window.Resources>
        <Storyboard x:Key="IntroStoryboard" Duration="0:0:3">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TitleText"
                                           Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.6" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:3.0" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SubtitleText"
                                           Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.6" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:3.0" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IntroTransform"
                                           Storyboard.TargetProperty="Y">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="18"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.1" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.5" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:3.0" Value="-10"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>
    <Grid Background="#FF040914">

        <Border BorderBrush="#3369D1FF"
                BorderThickness="1"
                Margin="20"
                CornerRadius="20"
                Background="#180B1425"/>

        <StackPanel x:Name="IntroPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="IntroTransform"/>
            </StackPanel.RenderTransform>
            <TextBlock x:Name="TitleText"
                       Text="CELESTIAL MECHANICS"
                       FontSize="54"
                       FontWeight="Bold"
                       Foreground="#FFBFE6FF"
                       Opacity="0"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="SubtitleText"
                       Text="SOLUTION FOR COSMIC SIMULATIONS"
                       Margin="0,12,0,0"
                       FontSize="18"
                       Foreground="#FF6FA7CC"
                       Opacity="0"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource IntroStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>
</Window>
